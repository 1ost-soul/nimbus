# 服务端配置示例（无真实凭据，仅供复制修改）
# 对应的 server.json 字段：
#   listen_addr     -> LISTEN_ADDR（TCP 监听地址）
#   quic_listen_addr-> QUIC_LISTEN_ADDR（UDP/QUIC 监听地址；留空则不启用）
#   webtransport_listen_addr -> WEBTRANSPORT_LISTEN_ADDR（HTTP/3/WebTransport 独立 UDP 地址；留空则不启用）
#   cert_file       -> CERT_FILE
#   key_file        -> KEY_FILE
#   psk             -> PSK_BASE64（必须是 32 字节的 base64）
#   web_root_html   -> WEB_ROOT_HTML（可选，Web 外壳内容）

LISTEN_ADDR="[::]:44444"
QUIC_LISTEN_ADDR=":44444"
WEBTRANSPORT_LISTEN_ADDR=":44445"
CERT_FILE="/path/to/fullchain.pem"
KEY_FILE="/path/to/privkey.pem"
PSK_BASE64="REPLACE_WITH_BASE64_32_BYTE_KEY"
WEB_ROOT_HTML=""
